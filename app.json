{
  "expo": {
    "name": "QuickCamNotes",
    "slug": "QuickCamNotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickcamnotes",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF1FF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
  "expo-router",
  [
    "expo-camera",
    {
      "cameraPermission": "Allow QuickCamNotes to access your camera.",
      "recordAudioAndroid": false
    }
  ],
  [
    "expo-splash-screen",
    {
      "backgroundColor": "#EAF1FF",
      "image": "./assets/images/icon.png",
      "imageWidth": 180
    }
  ]
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
